# ── Required ─────────────────────────────────────────────────────���────────
MONGO_URL=mongodb://localhost:27017
JWT_SECRET=change-me-to-a-long-random-secret

# ── Optional ──────────────────────────────────────────────────────────────
DB_NAME=openclaw
CORS_ORIGINS=http://localhost:3000

# ── AI Providers ──────────────────────────────────────────────────────────
# Emergent Universal Key (OpenAI / Anthropic / Gemini via emergent.sh)
EMERGENT_LLM_KEY=

# OpenRouter key (DeepSeek + 300+ models via openrouter.ai)
OPENROUTER_API_KEY=

# ── OAuth (Social Login) ──────────────────────────────────────────────────
# GitHub OAuth App — create at https://github.com/settings/developers
# Callback URL: https://yourdomain.com/auth/callback?provider=github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Callback URL: https://yourdomain.com/auth/callback?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Development only ──────────────────────────────────────────────────────
# Allows running without JWT_SECRET (insecure — never set in production)
# OPENCLAW_DEV=1
