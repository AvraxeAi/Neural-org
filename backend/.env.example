# ── Required ─────────────────────────────────────────────────────���────────
MONGO_URL=mongodb://localhost:27017
JWT_SECRET=change-me-to-a-long-random-secret

# ── Optional ──────────────────────────────────────────────────────────────
DB_NAME=openclaw
CORS_ORIGINS=http://localhost:3000

# ── AI Providers ──────────────────────────────────────────────────────────
# Emergent Universal Key (OpenAI / Anthropic / Gemini via emergent.sh)
EMERGENT_LLM_KEY=

# OpenRouter key (DeepSeek + 300+ models via openrouter.ai)
OPENROUTER_API_KEY=

# ── Development only ───────────────────────���─────────────────────────────
# Allows running without JWT_SECRET (insecure — never set in production)
# OPENCLAW_DEV=1
